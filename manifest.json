{
  "manifest_version": 3,
  "name": "Scope",
  "version": "3.3.1",
  "description": "Hover over an element and press Shift to inspect its CSS styles.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Scope",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": [
      "background/injection.js",
      "background/background.js"
    ]
  },
  "commands": {
    "start": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Start Scope in the current tab"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scope@mutantsan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
